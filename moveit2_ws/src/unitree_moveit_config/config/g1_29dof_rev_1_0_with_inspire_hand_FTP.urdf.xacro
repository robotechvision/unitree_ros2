<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="g1_29dof_rev_1_0_with_inspire_hand_FTP">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import g1_29dof_rev_1_0_with_inspire_hand_FTP urdf file -->
    <xacro:include filename="$(find unitree_ros2)/description/g1/g1_29dof_rev_1_0_with_inspire_hand_FTP.urdf" />

    <!-- Import control_xacro -->
    <xacro:include filename="g1_29dof_rev_1_0_with_inspire_hand_FTP.ros2_control.xacro" />


    <xacro:g1_29dof_rev_1_0_with_inspire_hand_FTP_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
